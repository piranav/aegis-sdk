{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/aegis.py\" hook codex SessionStart",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/aegis.py\" hook codex UserPromptSubmit",
            "timeout": 15,
            "statusMessage": "Aegis governance check"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/aegis.py\" hook codex PreToolUse",
            "timeout": 15,
            "statusMessage": "Aegis governance check"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/aegis.py\" hook codex PostToolUse",
            "timeout": 15,
            "statusMessage": "Aegis governance check"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/aegis.py\" hook codex SessionEnd",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
